<%
/* Interactive 3D models: information on the left, viewer on the right.

   Same Pandoc constraints as the other templates -- Quarto's EJS has no
   newline-trimming tag, and Pandoc reads indentation as a code block, blank
   lines as paragraph breaks, and only recognises BLOCK-level tags opening a
   line. So each control tag starts a line followed by real content, and no line
   opens with an inline element.

   The viewer is a click-to-load facade (see partials/model-viewer.html): a
   local poster until pressed, so neither three.js nor the model is fetched on
   page load. That matters more than for video, because OBJ is a plain-text
   format and gets large quickly. */
%><div class="model-list">
<% for (const item of items) { const model = String(item.model || "").trim(); const mtl = String(item.mtl || "").trim(); const poster = String(item.poster || "").trim(); const meta = [item.kind, item.venue].filter(Boolean).join(" · "); const subtitle = String(item.subtitle || "").trim(); const seats = Array.isArray(item.seats) ? item.seats : []; item.desc = String(item.description || "").replace(/<!--[\s\S]*?-->/g, "").trim(); %><div class="model-row">
<div class="model-row-body">
<% if (meta) { %><p class="model-row-meta"><%= meta %></p>
<% } %><h3 class="model-row-title"><%= item.title %></h3>
<% if (subtitle) { %><p class="model-row-subtitle"><%= subtitle %></p>
<% } %><% if (item.desc) { %><div class="model-row-desc"><%- item.desc %></div>
<% } %><p class="model-row-note">Click to load &middot; drag to orbit &middot; scroll to zoom<% if (seats.length) { %> &middot; pick a seat to listen (headphones recommended)<% } %></p>
</div>
<div class="model-row-viewer"><div class="model-viewer" data-model="<%- model %>"<% if (mtl) { %> data-mtl="<%- mtl %>"<% } %><% if (seats.length) { %> data-seats="<%- encodeURIComponent(JSON.stringify(seats)) %>"<% } %> role="button" tabindex="0" aria-label="Load interactive 3D model: <%= item.title %>"><div class="model-facade"><% if (poster) { %><img src="<%- poster %>" alt="" loading="lazy"><% } %><span class="model-facade-cue" aria-hidden="true"></span></div><p class="model-viewer-status"></p></div></div>
</div>
<% } %></div>
