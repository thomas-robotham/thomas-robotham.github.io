<%
/* Media: videos, interactive 3D models and images in ONE list, sorted by date,
   so an entry's `date:` sets its place among all of them.

   Every entry is one row: information left, a carousel of its media right
   (partials/media-carousel.html), and a "Read more" link to the entry's own
   page when it sets `read-more: true` (no link when false or left out).
   The carousel's cards, in this order:
     - a video card      when the entry has `video:` (with `poster:`)
     - a 3D-model card   when it has `model:` (+ `mtl:`, `camera:`, `seats:`,
                         `source:`, `speaker:`); its poster is `model-poster:`
                         on an entry that also has a video, else `poster:`;
                         `note:` replaces the line under it
     - one image card    per item under `images:` (`src:`, `caption:`, `alt:`)
   An entry with one card shows no arrows.

   The cards are handed to the carousel as URI-encoded JSON and built in the
   browser. filters/media-page.lua builds the same list for the entry's own
   page; keep the two in step when adding a field.

   Same Pandoc constraints as the other templates -- Quarto's EJS has no
   newline-trimming tag, and Pandoc reads indentation as a code block, blank
   lines as paragraph breaks, and only recognises BLOCK-level tags opening a
   line. So each control tag starts a line followed by real content, and no
   line opens with an inline element such as <a> or <button>. */
%><div class="media-rows-list">
<% for (const item of items) { const s = (v) => String(v || "").trim(); const vid = s(item.video); const model = s(item.model); const kind = s(item.kind); const venue = s(item.venue); const subtitle = s(item.subtitle); item.desc = s(item.description).replace(/<!--[\s\S]*?-->/g, "").trim(); const credit = s(item.credit); const view = item.camera && Array.isArray(item.camera.position) && Array.isArray(item.camera.target) ? item.camera : null; const cards = []; if (vid) cards.push({ type: "video", id: vid, title: item.title, poster: s(item.poster) }); if (model) cards.push({ type: "model", title: item.title, model, mtl: s(item.mtl), poster: vid ? s(item["model-poster"]) : s(item.poster), camera: view, seats: Array.isArray(item.seats) ? item.seats : [], source: item.source && Array.isArray(item.source.position) ? item.source : null, speaker: item.speaker && Array.isArray(item.speaker.range) ? item.speaker : null, note: s(item.note) }); for (const im of (Array.isArray(item.images) ? item.images : [])) { if (im && s(im.src)) cards.push({ type: "image", src: s(im.src), caption: s(im.caption), alt: s(im.alt) }); } %><div class="media-row">
<div class="media-row-body">
<% if (kind || venue) { %><p class="media-row-meta entry-meta"><% if (kind) { %><span class="entry-meta-kind"><%= kind %></span><% } %><% if (venue) { %><span class="entry-meta-item"><%= venue %></span><% } %></p>
<% } %><h3 class="media-row-title"><%= item.title %></h3>
<% if (subtitle) { %><p class="media-row-subtitle"><%= subtitle %></p>
<% } %><% if (item.desc) { %><div class="media-row-desc"><%- item.desc %></div>
<% } %><% if (credit) { %><p class="media-row-credit"><%= credit %></p>
<% } %><% if (item.headphones) { %><p class="media-row-note">Headphones recommended</p>
<% } %><% if (item["read-more"] === true) { %><p class="media-row-more"><a href="<%- item.path %>">Read more<span class="media-row-more-arrow" aria-hidden="true">→</span></a></p>
<% } %></div>
<div class="media-row-media"><div class="media-carousel" data-cards="<%- encodeURIComponent(JSON.stringify(cards)) %>"></div></div>
</div>
<% } %></div>
